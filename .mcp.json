{
  "mcpServers": {
    "hung-parliament": {
      "command": "node",
      "args": [
        "game/agent/bin/mcp.mjs"
      ],
      "env": {
        "HP_SERVER": "https://iqame0kk34.execute-api.ap-south-1.amazonaws.com",
        "HP_WS": "wss://y7rl4ork6c.execute-api.ap-south-1.amazonaws.com/live",
        "HP_SESSION_FILE": "game/agent/.sessions/mcp.session.json"
      }
    },
    "aws-api": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-south-1",
        "READ_OPERATIONS_ONLY": "true",
        "AWS_API_MCP_WORKING_DIR": "D:/Projects/world-parliament/.aws-mcp-work",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-iac": {
      "command": "uvx",
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
