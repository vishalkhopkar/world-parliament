# Copy to .env.local (or set in the build environment). When VITE_API_URL is empty the app uses the in-browser mock,
# unless the URL has ?server=local (-> http://<page host>:8787, ws://<page host>:8787/ws) or ?server=<http(s) base url>.
# ?mock always forces the mock. ?as=<name> keeps a separate saved session per name (several players in one browser profile).

# Base URL of the REST API (API Gateway HTTP API incl. stage, no trailing slash), e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=
# WebSocket endpoint WITHOUT query string, e.g. wss://xyz789.execute-api.ap-south-1.amazonaws.com/prod
# (default when empty: VITE_API_URL with http->ws and "/ws" appended, which matches the local dev server).
VITE_WS_URL=
