{
  "name": "hung-parliament",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "infra",
    "sim",
    "agent",
    "chat"
  ],
  "scripts": {
    "gen:maps": "tsx scripts/gen-maps.ts",
    "gen:config": "tsx scripts/gen-config.ts",
    "check:maps": "tsx scripts/gen-maps.ts --check",
    "check:config": "tsx scripts/gen-config.ts --check",
    "pretest": "npm run gen:maps && npm run gen:config",
    "test": "npm run test --workspaces --if-present",
    "test:maps": "python -I -m pytest ../maps -q",
    "test:gaps": "tsx scripts/coverage-gaps.ts",
    "check:gaps": "tsx scripts/coverage-gaps.ts --strict",
    "test:e2e": "tsx scripts/e2e.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "build": "npm run gen:maps && npm run gen:config && npm run typecheck && npm test && npm run check:gaps && npm run test:maps && npm run build -w @hp/web",
    "verify": "npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
